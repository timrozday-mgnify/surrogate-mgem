// Site config for the pair-interactions pipeline on Slurm. Copy to hpc.config next to
// this file, fill in the <...> values; run_hpc.sh passes it with -c.
params {
    data   = '<shared storage>/pair-data'                 // stage_data.sh bundle, rsync'd here
    outdir = '<shared storage>/pair-interactions/v2'  // v2: independent seeds, survey, prune
    // pair = 'CP040530.1,CP070062.1'  // must be in the bundle (stage_data.sh <src> <out> A B)
    // seeds = '0,1,2,3,4'              // the default; add seeds where no mechanism has a majority
    // survey_shards = 8                 // x 500 media per arm; raise while the curve still rises
}

process {
    // queue = '<partition>'
    // clusterOptions = '--account=<account>'
}

executor {
    queueSize = 50
}
