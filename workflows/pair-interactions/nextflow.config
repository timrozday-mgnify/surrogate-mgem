params {
    pair       = 'CP040530.1,CP070062.1'  // genome ids, as in the label shards and gems/<id>.xml
    data       = 'pair-data'              // bundle made by stage_data.sh
    seeds      = '0,1,2'                  // medium-draw seeds: the search is stochastic, read the spread
    args       = ''                       // extra `cfs interactions` options for every run, e.g. '--draws 128'
    // A model: heads + the label root they were trained on (+ c^eq in mM for the true LP).
    // `fba` is plain FBA; `ceq1mM` is §13.11 product inhibition at c^eq = 1 mM, whose heads
    // carry the theta channel (labels_i3; 0.1 mM starves 13 of 21 organisms). Paths are
    // relative to --data.
    arms = [
        [name: 'fba',    value: 'value_p4r2',     behaviour: 'behaviour_p4r2', labels: 'labels_p4', ceq: null],
        [name: 'ceq1mM', value: 'value_i3_cap',   behaviour: 'behaviour_i3',   labels: 'labels_i3', ceq: 1.0],
    ]
    // What the design maximises (`cfs interactions --help`). inhibited_args are added in
    // arms with a c^eq; inhibited_only objectives are skipped in arms without one.
    objectives = [
        [name: 'handover',     args: '--seed-mode candidate', inhibited_args: '--inhibited-links 200'],
        [name: 'interference', args: '--objective interference --seed-mode candidate'],
        [name: 'conditioning', args: '--objective conditioning --seed-mode conditioning', inhibited_only: true],
    ]
    outdir     = 'results'
    venv       = "${projectDir}/../../.venv"  // created by setup.sh
    python     = "${params.venv}/bin/python"
    cfs        = "${params.venv}/bin/cfs"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    // One run: ~13-40 min on a laptop core (2026-09-07/08 logs); GEMs + heads ~3 GB.
    withLabel: 'process_interactions' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_crosseval' {  // ~4 LP solves per (medium, model); minutes
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}

env {
    // one solver/XLA thread per task: parallelism is the task fan-out (CLAUDE.md)
    OMP_NUM_THREADS = '1'
    XLA_FLAGS       = '--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1'
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    fields    = 'task_id,name,tag,status,exit,cpus,realtime,%cpu,peak_rss'
}

// Everything runs on the host in the project's venv (setup.sh), as in
// kmer-functional-profiler; there are no third-party containers here, so the
// singularity profile only matters if you add one.
profiles {
    slurm {
        process.executor = 'slurm'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity"
    }
    test {
        // one seed, a tiny search: checks the plumbing in minutes, not the science
        params.seeds  = '0'
        params.args   = '--draws 8 --starts 1 --verify-steps 1 --box 0'
        params.outdir = 'results-test'
        params.objectives = [
            [name: 'handover',     args: '--seed-mode candidate'],
            [name: 'conditioning', args: '--objective conditioning --seed-mode conditioning', inhibited_only: true],
        ]
        trace.file    = 'results-test/trace.tsv'
    }
}
