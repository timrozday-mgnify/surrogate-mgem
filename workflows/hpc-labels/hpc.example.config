// Site config for the label/head chain on Slurm. Copy to hpc.config next to this
// file, fill in the <...> values; run_hpc.sh passes it with -c.
params {
    data   = '<shared storage>/labels-data'          // stage_inputs.sh bundle, rsync'd here
    outdir = '<shared storage>/20hm_v2'              // the run root stage_data.sh then reads

    // The two label roots are ~30 MB an organism each and the work dir holds another
    // copy of everything: budget ~10 GB for 21 organisms x 2 arms, plus ~0.3 GB a
    // checkpoint. `cfs generate` dies mid-shard on a full disk.
}

process {
    // queue = '<partition>'
    // clusterOptions = '--account=<account>'
}

executor {
    queueSize = 50
}
