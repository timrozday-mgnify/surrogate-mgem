params {
    // Bundle made by stage_inputs.sh: roster.csv, metabolite_index.json, gems/<id>.xml.
    // The index must be the one frozen on THIS roster -- a new GEM set changes the
    // exchange set, so an old index_hash is a different model (P13).
    data   = 'labels-data'
    outdir = 'results'
    organisms = ''          // comma-separated subset; '' = every row of roster.csv

    // §4.5 design. 4000 media is the laptop-sized fifth of the D10 budget the
    // 20hm_bands roots were built at; the round-1 pass is the community regime
    // (§8.6d) at 20% of it.
    // n_media must comfortably exceed |A_i| (11-32 on the 21-genome roster): the
    // design spends the first |A_i| media on the single-limitation corners and the
    // strata only balance out of the remainder, so below that the per-organism count
    // becomes |A_i|-dependent and `data._stack` refuses to stack the roster (§6.1).
    n_media       = 4000
    round1_media  = 800
    round1_bg     = 0.9

    // Level-1 trial media (§8.6c) and the community lists, both seeded so they are a
    // property of (roster, seed) rather than of when the run happened.
    holdout_media  = 200
    holdout_seed   = 7000
    community_seed = 20251020

    // §8.6d round 2: the n=15 trajectories whose states get labelled, and the stride
    // the pool takes along them (consecutive states are near-duplicates).
    n15_seeds   = '0,100'
    n15_sets    = 16
    n15_size    = 15
    pool_stride = 5

    behaviour_epochs = 600
    value_args       = ''   // extra `cfs train-value` options

    // One arm per ground-truth model. `labels`/`value`/`behaviour` are the names
    // pair-interactions/stage_data.sh looks for, so do not rename them casually.
    // `value_interim`/`behaviour_interim` are the throwaway fba heads that walk the
    // round-2 trajectories. `round2` is the fba arm only: labels_i3 is base + round 1.
    arms = [
        [name: 'fba', labels: 'labels_p4', value: 'value_p4r2', behaviour: 'behaviour_p4r2',
         ceq: null, round2: true, value_interim: 'value_p4', behaviour_interim: 'behaviour_p4'],
        [name: 'ceq1mM', labels: 'labels_i3', value: 'value_i3_cap', behaviour: 'behaviour_i3',
         ceq: 1.0, round2: false],
    ]

    venv   = "${projectDir}/../../.venv"   // created by ../pair-interactions/setup.sh
    python = "${params.venv}/bin/python"
    cfs    = "${params.venv}/bin/cfs"
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_single' {
        cpus = 1; memory = { 4.GB * task.attempt }; time = { 1.h * task.attempt }
    }
    // ~1 h an organism for the base pass on a laptop core, plus ~20% for round 1.
    // It dies mid-shard on a full disk and the partial shard must be deleted, not
    // resumed -- which is free here, since a failed task's work dir is thrown away.
    withLabel: 'process_generate' {
        cpus = 1; memory = { 6.GB * task.attempt }; time = { 12.h * task.attempt }
    }
    withLabel: 'process_generate_media' {   // ~8.5 min an organism
        cpus = 1; memory = { 6.GB * task.attempt }; time = { 4.h * task.attempt }
    }
    // 10 communities x 200 media x that community's members, ~0.11 s a solve: ~20 min.
    withLabel: 'process_holdout' {
        cpus = 1; memory = { 8.GB * task.attempt }; time = { 8.h * task.attempt }
    }
    // --epochs 0, but it loads every organism's shards at once.
    withLabel: 'process_head_a' {
        cpus = 1; memory = { 48.GB * task.attempt }; time = { 6.h * task.attempt }
    }
    withLabel: 'process_head_b' {
        cpus = 1; memory = { 48.GB * task.attempt }; time = { 24.h * task.attempt }
    }
    // The dominant cost: a true LP per member per Euler step, 15 cobra models held at
    // once (~0.2 GB each). One community per task, so the 32 of them run in parallel.
    withLabel: 'process_community' {
        cpus = 1; memory = { 12.GB * task.attempt }; time = { 24.h * task.attempt }
    }
}

env {
    // one solver/XLA thread per task: parallelism is the task fan-out (CLAUDE.md)
    OMP_NUM_THREADS = '1'
    XLA_FLAGS       = '--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1'
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    fields    = 'task_id,name,tag,status,exit,cpus,realtime,%cpu,peak_rss'
}

profiles {
    slurm {
        process.executor = 'slurm'
    }
    // Plumbing only, in minutes: two organisms, a handful of media, 2 communities.
    // Every CLI invocation in modules.nf runs for real -- that is the point of it.
    test {
        params.n_media       = 96    // > max |A_i|, see above
        params.round1_media  = 64
        params.holdout_media = 2
        params.n15_seeds     = '0'
        params.n15_sets      = 2
        params.n15_size      = 2
        params.pool_stride   = 20
        params.behaviour_epochs = 5
        params.outdir        = 'results-test'
        trace.file           = 'results-test/trace.tsv'
        // the real asks are a cluster's; the repo-root config's `resourceLimits`
        // only caps at --max_memory, so the test profile sets them outright
        process { withLabel: 'process_head_a'     { memory = 6.GB } }
        process { withLabel: 'process_head_b' { memory = 6.GB } }
        process { withLabel: 'process_community'       { memory = 4.GB } }
        process { withLabel: 'process_holdout'         { memory = 4.GB } }
    }
}
