params {
    // Required
    roster           = null   // roster CSV: genome_id, model_path (SBML/CarveMe GEMs)
    outdir           = './results'
    help             = false
    stage            = 'train'  // 'qc' (M0+M1 QC) | 'labels' (§4.5 labels) | 'sweep' (M3b Head A) | 'train' (legacy)
    index            = null     // stages 'labels'/'sweep': frozen metabolite_index.json from the qc stage

    // --- M0/M1 ground-truth QC (stage 'qc') -----------------------------------
    qc_memote        = true       // run MEMOTE snapshots (needs memote in the data image)
    degeneracy_alpha = '1.0,0.7'  // growth fractions for the exchange-FVA survey
    degeneracy_media = 50         // media sampled per organism for the survey

    // Publishing
    publish_dir_mode = 'copy'

    // --- §4.5 bulk label generation (stage 'labels') --------------------------
    // Media per organism. The plan's D10 scale is 20000 (SamplingConfig's own
    // default); 4000 is the laptop-sized first pass -- 1/5 the budget, same design.
    label_media      = 4000
    // §4.7: bands anchor themselves via the LP demand probe (~2 s, ~350 LPs per
    // organism, no previous run needed). Setting label_scales instead falls back to
    // a scales.json from a previous run; label_probe=false does neither and puts
    // every metabolite in one shared band -- the pre-band design, measured worse.
    label_probe      = true
    label_scales     = null   // JSON {genome_id: {exchange: scale}}; only a fallback
    // §4.6 top-up: focus weights from `cfs topup` (i.e. from a trained cell's
    // held-out per_limiting_metabolite), spent into part.round<N>.parquet.
    label_focus_weights = null
    label_round      = 0      // >0 writes a round shard beside the base ones

    // --- M3b/§7.4 Head A sweep (stage 'sweep') --------------------------------
    // One task per row of the samplesheet; the row carries its own flags, so there
    // is no param per sweep axis. `examples/value_sweep/make_sweep.py` writes it.
    sweep            = null   // samplesheet CSV: cell_id, arch, labels, args
    // Organism-axis sharding for `cfs train-value` (1.8x on CPU at 3 devices).
    // MUST divide the roster's organism count -- `train._shard_organisms` logs and
    // runs unsharded otherwise. 0 disables. 21 organisms -> 3 or 7.
    xla_devices      = 0

    // --- Seed data generation -------------------------------------------------
    num_shards          = 10      // HPC fan-out: communities split across this many `generate` tasks
    n_communities       = 200     // total communities sampled (the "large seed dataset" size knob)
    community_size_min  = 2
    community_size_max  = 6
    media_per_community = 40
    // titrate: keeps the community's essential nutrients and titrates uptake inside
    // the growth-limiting regime. The alternatives leave growth flat at 0 (random
    // subsets miss the essential set) or saturated -- see docs in sampling.py.
    sampler             = 'titrate'  // titrate | perturb | sparse | dirichlet | lhs
    keep_min            = 0.5     // titrate: lowest per-medium keep probability
    n_limiting          = 3       // titrate: nutrients made scarce per medium (rest replete)
    target_frac         = 0.5     // titrate: calibrate uptake to this fraction of saturated growth
    tradeoff            = 0.35
    max_uptake          = 1000.0  // titrate: only the ceiling for calibration; a hard bound otherwise
    solver              = 'hybrid'   // HiGHS via optlang (no CPLEX/Gurobi licence)
    seed                = 0
    min_growth_frac     = 0.02    // abort the merge if fewer samples than this grew (0 disables)

    // --- Active-learning supplementation --------------------------------------
    n_communities_augment = 20    // top-N communities (by feasible seed samples) to train/augment
    active_rounds         = 5     // discrete rounds per community (0 = skip, train on seed data)
    active_batch_size     = 16    // real solves per round
    active_n_candidates   = 2000  // media proposed per round
    active_n_models       = 5     // acquisition ensemble size
    active_hidden         = '256,256'
    active_epochs         = 1000  // max-epoch cap; training early-stops
    n_active              = 20    // sparse sampler: active components per medium

    // --- Model sweep ----------------------------------------------------------
    // Swept dimensions (list syntax mirrors the reference: ',' items, ';' arch specs).
    hidden_configs = '256,256;512,512,512'  // architectures: widths per layer
    n_models_list  = '3,5'                   // ensemble sizes
    train_sizes    = '200,500,1000'          // --n-train caps (learning curve)
    n_features_list = '0'  // --n-features caps swept as a sweep axis (0 = all exchanges)
    train_epochs   = 1000  // max-epoch cap; training early-stops
    test_size      = 0.2

    // Resource limits (overridden by HPC/cloud profiles)
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '240.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled    = true
        // HOME: running as the host uid leaves HOME unset (=> '/'), and cobra
        // creates a cache dir under it on import -> PermissionError.
        docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // Same cobra ~/.cache write as the docker profile: a read-only or
        // unwritable $HOME on a cluster node kills the solver tasks on import.
        singularity.runOptions = '--env HOME=/tmp'
    }
    conda {
        conda.enabled = true
    }
}

manifest {
    name            = 'surrogate-mgem'
    description     = 'HPC training sweep for learned surrogate metabolic models (data generation, active learning, architecture/ensemble/data-size sweep)'
    version         = '0.1.0'
    nextflowVersion = '>=25.0'
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
    overwrite = false
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = false
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = false
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = false
}
