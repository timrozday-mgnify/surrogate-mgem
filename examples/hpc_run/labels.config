// Params for stage 1, label generation at D10 scale (see README.md). Every value below is a
// default from nextflow.config unless the comment says otherwise; the comments
// mark the ones you are most likely to want to change.

params {
    // --- the one value that makes this the D10 run ---------------------------
    // 20000 media/organism is the plan's D10 budget and SamplingConfig's own
    // default; nextflow.config ships 4000, the laptop-sized pass that every
    // measurement so far used. This is 5x that, and the cost is linear in it.
    label_media  = 20000

    // §4.7: bands anchor themselves from an LP demand probe on each model
    // (~2 s, ~350 LPs per organism). Leave it on — it needs no previous run, and
    // it is what stops every metabolite sharing one band, which was measured to
    // hand nearly every limiting medium to whichever metabolite has the smallest
    // scale. `label_scales` is only a fallback for when a probe finds no anchor.
    label_probe  = true
    label_scales = null

    // §4.6 top-up: leave both at their defaults for a base run. Set them only to
    // add a round of media where a trained cell is worst, which writes
    // part.round<N>.parquet beside the base shards rather than replacing them.
    label_focus_weights = null
    label_round  = 0

    seed         = 0

    publish_dir_mode = 'copy'

    // Laptop ceilings. CHANGE ON HPC: raise these, or leave them and put the real
    // ceilings in site.config, which is merged after this file.
    max_cpus     = 8
    max_memory   = '24.GB'
    max_time     = '48.h'
}

process {
    // One task per organism, and the fan-out IS the parallelism: cobra must never
    // parallelise inside a task. An exchange-FVA that takes ~1 s single-threaded
    // went to *not finishing in 30 minutes* with a worker pool, because each
    // worker re-pickles the GEM. HiGHS is likewise pinned to threads=1 so labels
    // are repeatable. So: one core, and 21 tasks wide.
    withName: 'GENERATE_LABELS' {
        cpus   = { 1 }
        // 8 GB is ~4x the measured peak. `cfs generate` materialises one eps
        // level's rows before writing the parquet: 160000 rows x three |M_i|-long
        // float lists measures ~1.1 GB, plus ~0.6 GB for cobra and the model.
        memory = { 8.GB * task.attempt }
        // process_low's default is 4.h, which is right for the 4000-media run and
        // NOT for this one: 20000 media is ~5 h/organism, so every first attempt
        // would hit the wall and only succeed on the retry. Measured basis: ~1 h
        // per organism at 4000 media.
        time   = { 16.h * task.attempt }
    }
}
