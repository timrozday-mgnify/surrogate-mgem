// EXAMPLE site config -- copy, edit, and pass with `-c` to BOTH stages.
// Deliberately not a profile in the repo: the executor and the queue names are
// properties of one cluster, and baking them into nextflow.config makes the
// pipeline wrong everywhere else.
//
//   NF_PROFILE=singularity ./run_labels.sh -c site.config
//   NF_PROFILE=singularity ./run_sweep.sh  -c site.config

process {
    executor       = 'slurm'
    queue          = 'long'          // EDIT: tasks here run for hours, not minutes
    // EDIT: whatever your site needs (account, QoS, constraints).
    clusterOptions = '--account=my_account'
}

executor {
    // Stage 1 is 21 independent single-core tasks; stage 2 is up to 30 cells, the
    // longest of them the deepsets. Neither has a reduce step worth throttling for,
    // so the cap is really just politeness to the queue.
    queueSize       = 25
    submitRateLimit = '10/1min'
}

singularity {
    enabled    = true
    autoMounts = true
    // EDIT: a shared path, so parallel tasks converting the same image do not race.
    // Both stages pull from ghcr.io/timrozday-mgnify/surrogate-mgem-{data,train}:0.1.5
    // and singularity/apptainer converts the Docker image on first pull.
    cacheDir   = '/scratch/$USER/singularity'
    runOptions = '--env HOME=/tmp'
}

params {
    // The real ceilings. resourceLimits in conf/base.config reads these, and it is
    // a closure precisely so a `-c` file like this one still wins.
    max_cpus   = 32
    max_memory = '256.GB'
    max_time   = '72.h'
}
