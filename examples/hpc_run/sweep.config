// Params for stage 2, the M3b Head A sweep (see README.md). Every value below is a
// default from nextflow.config unless the comment says otherwise; the comments mark
// the ones you are most likely to want to change.

params {
    // The sweep's per-cell knobs are NOT here -- they live in the samplesheet's
    // `args` column, one row per cell (see make_sweep.py). What is left is the
    // handful of things that are properties of the run, not of a cell.

    // Organism-axis sharding for `cfs train-value`. MUST divide the roster's
    // organism count or `train._shard_organisms` logs and runs unsharded: 21
    // organisms -> 3 or 7, and 3 measured 1.8x (10.1 -> 5.6 s/epoch, deepset,
    // batch 512). CHANGE ON HPC: set it to a divisor and match `cpus` below.
    // 0 = single device, which is right for a laptop.
    xla_devices      = 0

    publish_dir_mode = 'copy'

    // Ceilings, i.e. `process.resourceLimits`. These clamp the per-process
    // directives below -- including on retry -- so a ceiling below what a cell
    // needs is not a safety net, it is what makes the retry ladder a no-op.
    // Lower them in site.config if your queue is smaller.
    max_cpus         = 8
    // NOT a laptop number, and the one that bit: `resourceLimits` clamps every
    // retry too, so a 24.GB ceiling turned `memory * task.attempt` into a ladder
    // that never climbed and the deepset cells were OOM-killed at every attempt.
    // MEASURED, --arch deepset --phi-hidden 64 --k-code 64 --batch 512, 4000 media:
    // 2.1 GB to load, 16.8 GB peak in the training step, and evaluation adds 0.00
    // on top. The training peak is set by (organisms x batch x 444 x phi_hidden)
    // activations through a second-order (Sobolev) tape, so it does NOT fall with
    // the label budget -- 20000 media only adds the resident arrays, ~21 GB, and
    // --phi-hidden 128 roughly doubles the activation half. --batch is the knob if
    // a cell still will not fit.
    max_memory       = '192.GB'
    // 12.h here capped TRAIN_VALUE's own 24.h. One deepset cell measured 47 s/epoch
    // on a laptop at 1/5 the rows -- ~19 h for 1500 epochs before this run's 5x.
    max_time         = '48.h'
}

process {
    // A cell is one long single-process job, not a fan-out: `cfs train-value` is
    // JAX on CPU here, and the organism axis is the only parallel axis it has.
    // Measured on a laptop at width 128 / depth 3 / 4000 media: 0.35 s/epoch for the
    // ICNN (~9 min at 1500 epochs) against 47 s/epoch for a deepset with `phi` at
    // width//2 -- i.e. 19 h. The deepset arm is what needs the cluster.
    withName: 'TRAIN_VALUE' {
        cpus   = { params.xla_devices as int > 0 ? params.xla_devices as int : 4 }
        // Sized off the measurements above, and split by arm because the deepset
        // needs 4x what the rest do -- one blanket number either OOMs the deepsets
        // or reserves 48 GB for 17 cells that use 6. `task.tag` is the cell id, so
        // this reads the arm straight off the samplesheet row.
        memory = { (task.tag?.contains('deepset') ? 48.GB : 16.GB) * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // The forest trains 21 organisms x 100 trees and finite-differences its
    // gradients, so it is memory-hungry and short rather than long.
    withName: 'BASELINE_RF' {
        cpus   = { 2 }
        memory = { 24.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}
