// EXAMPLE site config -- copy, edit, and pass with `-c`. Deliberately not a profile
// in the repo: the executor and the queue names are properties of one cluster, and
// baking them into nextflow.config makes the pipeline wrong everywhere else.
//
//   NF_PROFILE=singularity SWEEP=sweep_full.csv \
//     INDEX=/path/to/qc/metabolite_index.json ./run.sh -c site.config

process {
    executor       = 'slurm'
    queue          = 'standard'      // EDIT: your partition
    // EDIT: whatever your site needs (account, QoS, constraints).
    clusterOptions = '--account=my_account'
}

executor {
    // 54 cells in sweep_full.csv, most of them hours long. Cap the in-flight jobs
    // rather than the total.
    queueSize      = 20
    submitRateLimit = '10/1min'
}

singularity {
    enabled    = true
    autoMounts = true
    // EDIT: a shared path, so 54 tasks converting the same image do not race.
    cacheDir   = '/scratch/$USER/singularity'
    runOptions = '--env HOME=/tmp'
}

params {
    // The real ceilings. resourceLimits in conf/base.config reads these, and it is a
    // closure precisely so a `-c` file like this one still wins.
    max_cpus   = 32
    max_memory = '256.GB'
    max_time   = '72.h'
}
