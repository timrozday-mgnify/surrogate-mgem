// Site config for the bacteria half of the gap-filled panel on codon. Copy to
// hpc.bacteria.config, fill in <...>, and run_hpc.sh passes it with -c after
// -profile codon, so this wins.
//
// The taxon and the reference database live in the SAME file on purpose: they
// must agree, and a run that gap-fills against the wrong reference set is not
// an error anyone would notice in the output.
params {
    databases {
        gapseq {
            path = '<shared storage>/gapseq_ref/bacteria/gapseq_db'   // setup_hpc.sh prints this
        }
    }
}

process {
    withName: 'GAPSEQ_DOALL' {
        // conf/codon.config sets maxForks = 200. That is a CPU number, and here
        // it is also a DISK number: the module does `cp -rL ${db}
        // ./gapseq_db_local` in every task, so the whole reference database is
        // duplicated once per *running* task. Peak scratch is
        // maxForks x (database size). setup_hpc.sh prints that size; set this to
        // what the work filesystem can hold. 23 genomes never need 200 slots.
        maxForks = 8
        // cpus / memory / time come from conf/codon.config
    }

    // queue = '<partition>'
    // clusterOptions = '--account=<account>'
}

executor {
    queueSize = 50
}
