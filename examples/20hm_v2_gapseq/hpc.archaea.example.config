// Site config for the archaea half of the gap-filled panel on codon. Copy to
// hpc.archaea.config, fill in <...>, and run_hpc.sh passes it with -c after
// -profile codon, so this wins.
//
// The taxon and the reference database live in the SAME file on purpose: they
// must agree, and a run that gap-fills against the wrong reference set is not
// an error anyone would notice in the output.
params {
    databases {
        gapseq {
            path = '<shared storage>/gapseq_ref/archaea/gapseq_db'   // setup_hpc.sh prints this
        }
    }
}

process {
    withName: 'GAPSEQ_DOALL' {
        // VERIFY against `gapseq doall -h` in the image before the real run:
        // this is the taxonomy flag gapseq's find step uses, and it is the only
        // reason the archaeon is a separate run. If doall spells it differently,
        // this is the one line to change.
        ext.args = '-t Archaea'
        maxForks = 1          // one genome
        // cpus / memory / time come from conf/codon.config
    }

    // queue = '<partition>'
    // clusterOptions = '--account=<account>'
}

executor {
    queueSize = 50
}
