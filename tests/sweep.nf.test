nextflow_pipeline {
    name "Pipeline stub: M3b Head A sweep (sweep stage)"
    script "../main.nf"
    tag "pipeline"

    test("stub wires the sweep stage, both arch branches") {
        options "-stub"
        when {
            params {
                stage  = "sweep"
                // The example's smoke sheet: icnn-u + deepset-u-private + mlp + groupmax-u ->
                // TRAIN_VALUE, rf -> BASELINE_RF.
                sweep  = "$projectDir/examples/hpc_run/sweep_smoke.csv"
                index  = "$projectDir/examples/hpc_run/reference/metabolite_index.json"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/sweep/stub__icnn-u/diagnostics.json").exists() },
                { assert path("$outputDir/sweep/stub__mlp/value_heads.eqx").exists() },
                { assert path("$outputDir/sweep/stub__rf/diagnostics.json").exists() },
                // The shared-trunk branch: a `deepset-u` cell must NOT be fanned out
                // per organism, or its shared trunk silently becomes a private one.
                { assert path("$outputDir/sweep/stub__deepset-u-private/diagnostics.json").exists() },
                // One header + one row per cell: the collect step saw all five.
                { assert path("$outputDir/sweep/stub__groupmax-u/diagnostics.json").exists() },
                { assert path("$outputDir/sweep_leaderboard.csv").readLines().size() == 6 },
            )
        }
    }

    test("sweep stage requires --sweep") {
        options "-stub"
        when {
            params {
                stage  = "sweep"
                index  = "$projectDir/examples/hpc_run/reference/metabolite_index.json"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("needs --sweep") } || workflow.errorReport.contains("needs --sweep")
        }
    }
}
